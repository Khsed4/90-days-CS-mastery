# ============================================================
# Production Environment — 90-Day CS Mastery
# Copy this to .env on your Oracle server and fill in values
# NEVER commit this file with real secrets to git
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_strong_root_pass
DB_NAME=challenges_90days
DB_USER=appuser
DB_PASSWORD=change_me_strong_app_pass

# ── JWT Secrets (generate with: openssl rand -hex 64) ───────
JWT_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_EXPIRES_IN=7d

# ── Seed ─────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change_me_admin_password

# ── Frontend (baked into Next.js bundle at build time) ───────
# This MUST be the public HTTPS URL your users will call from their browser
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ── SMTP / Email ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16char_app_password
SMTP_FROM=your_email@gmail.com
