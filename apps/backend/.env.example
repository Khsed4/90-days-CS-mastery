# Backend Configuration Example
PORT=4000
NODE_ENV=development

# MySQL Database connection (Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/challenges_90days"

# JWT Authentication Secret
JWT_SECRET="super-secret-jwt-key-90days-mastery-app"
JWT_EXPIRES_IN="7d"

# Email Verification (SMTP)
# Leave empty to test with terminal/console output fallback in development
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@90dayschallenge.com"
