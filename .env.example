# ==========================================
# 90-Days CS Challenges Platform Environment
# ==========================================

# Database Connection (MySQL Prisma URL)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/challenges_90days"

# Backend Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database Seeder Credentials (Idempotent initial admin)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin

# Frontend Public API URL (Only NEXT_PUBLIC_ variables are exposed to client-side bundles)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Optional SMTP Email Configuration (If not configured, OTP codes will print to terminal console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@90dayschallenges.com
