# ==========================================
# 90-Days CS Challenges Platform Environment
# ==========================================

# Backend Database Connection (MySQL)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/challenges_90days"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Backend Server Port
PORT=4000

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Optional SMTP Email Configuration (If not configured, OTP codes will print in console)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@90dayschallenges.com"
